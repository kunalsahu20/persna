# ─── Model Provider API Keys ───
# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — never commit real keys.

# Ollama Cloud — get a key from https://ollama.com/settings/keys
# Leave blank to disable the cloud provider and use local Ollama only.
VITE_OLLAMA_CLOUD_API_KEY=

# ─── Render Worker (image / video generation) ───
# Base URL of the local ComfyUI render worker. See worker/README.md.
VITE_RENDER_API_URL=http://localhost:8188
